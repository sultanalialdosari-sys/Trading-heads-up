{
  "version": 3,
  "timezone_display": "Asia/Riyadh",
  "live": {
    "max_price": 5.0,
    "min_price": 0.20,
    "min_dollar_volume": 300000,
    "max_day_change_pct": 25.0,
    "min_rvol": 2.0,
    "spike_mult": 3.0,
    "window_bars": 12,
    "max_range_atr": 3.0,
    "max_range_pct": 8.0,
    "near_res_min_pct": 0.5,
    "near_res_max_pct": 5.0,
    "max_spread_pct": 2.0,
    "min_score": 65,
    "target_r": 2.0,
    "slippage_pct": 0.5,
    "ext_min_change_pct": 8.0,
    "pre_min_dollar_volume": 150000,
    "post_min_dollar_volume": 75000,
    "ext_max_from_high_pct": 15.0,
    "ext_min_score": 60,
    "ext_shortlist": 40
  },
  "universe": {
    "exchanges": ["NASDAQ", "NYSE", "AMEX"],
    "include_inactive": true,
    "price_raw": { "min": 0.20, "max": 5.00 },
    "min_dollar_volume_20d": 250000,
    "exclude_types": ["ETF", "warrant", "unit", "right"]
  },
  "filters": {
    "rvol": { "min": 3.0, "lookback_days": 20, "time_of_day_matched": true },
    "gap_pct": { "min": 5.0, "max": 80.0 },
    "shares_out": { "max": 50000000, "stale_days": 400, "allow_unknown": true },
    "sec_block_forms": ["S-1", "S-3", "424B3", "424B4", "424B5"],
    "sec_block_items": ["1.03", "3.01"],
    "sec_block_window_days": 5,
    "news": { "required": false, "max_age_min": 120 },
    "one_signal_per_symbol_day": true,
    "entry_window_et": ["09:45", "15:00"]
  },
  "exits": {
    "stop": { "type": "atr", "atr_mult": 1.5, "min_pct": 4.0 },
    "target_r": [1.5, 2.0, 3.0],
    "time_exit_et": "15:55",
    "same_bar_rule": "stop_first",
    "gap_rule": "fill_at_open"
  },
  "costs": {
    "fees": { "sec_per_million": 20.60, "taf_per_share": 0.000195, "taf_max": 9.79 },
    "scenarios": { "optimistic": 0.003, "base": 0.005, "pessimistic": 0.010 },
    "judge_on": "base",
    "spread_floor": { "lt_1": 0.010, "1_to_5": 0.003 },
    "slip_cap_per_side": { "lt_1": 0.010, "1_to_5": 0.005 },
    "liquidity_mult": { "dv_lt_250k": 1.5, "rvol_lt_2": 1.3 },
    "tick": { "lt_1": 0.0001, "ge_1": 0.01 }
  },
  "execution": {
    "bar_tf": ["1Min", "5Min"],
    "fill": "next_bar_open",
    "halt_gap_min": 5,
    "no_entry_bars_after_halt": 2
  },
  "validation": {
    "train": ["2016-01-01", "2022-12-31"],
    "test_from": "2023-01-01",
    "embargo_days": 5,
    "walk_forward": { "train_months": 24, "test_months": 6 },
    "bootstrap": { "n": 10000, "block": "day", "seed": 7 },
    "alpha": 0.05,
    "multiple_testing": "benjamini_hochberg",
    "min_trades": 100,
    "min_days": 60,
    "max_free_params": 4
  },
  "paper": {
    "shares_per_trade": 500,
    "live_orders": false
  }
}
